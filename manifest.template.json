{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "2.12.4",
  "description": "__MSG_appDescription__",
  "default_locale": "en",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "alarms",
    "notifications"
  ],
  "action": {
    "default_title": "__MSG_popupTitle__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://wplace.live/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://wplace.live/*"
      ],
      "resources": [
        "dist/inject.js",
        "assets/fonts/k8x12/k8x12S.ttf",
        "assets/fonts/Bytesized/Bytesized-Regular.ttf",
        "assets/fonts/misaki/misaki_gothic.ttf",
        "assets/fonts/comic_sans_ms_pixel/comic_sans_ms_pixel.ttf",
        "assets/fonts/khdotfont-20150527/KH-Dot-Akihabara-16.ttf",
        "assets/fonts/khdotfont-20150527/KH-Dot-Dougenzaka-12.ttf",
        "assets/fonts/khdotfont-20150527/KH-Dot-Hatchoubori-16.ttf",
        "assets/fonts/khdotfont-20150527/KH-Dot-Kabutochou-16.ttf",
        "assets/fonts/khdotfont-20150527/KH-Dot-Kagurazaka-12.ttf",
        "assets/fonts/khdotfont-20150527/KH-Dot-Kodenmachou-12.ttf",
        "assets/fonts/khdotfont-20150527/KH-Dot-Ningyouchou-16.ttf",
        "assets/images/tutorial/how_to_draw.gif",
        "assets/images/tutorial/how_to_archive.gif",
        "assets/images/tutorial/how_to_draw_archive.gif",
        "assets/images/tutorial/how_to_draw_text.gif",
        "assets/images/tutorial/how_to_bookmark.gif",
        "assets/images/bookmark/bookmark-button-location.png"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
