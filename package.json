{
  "name": "mr-wplace",
  "version": "2.13.3",
  "license": "MPL-2.0",
  "scripts": {
    "build": "esbuild src/content.ts src/popup.ts src/inject.ts src/inject/workers/migration.worker.ts src/inject/workers/snapshot-export.worker.ts src/inject/workers/gallery-export.worker.ts --bundle --outdir=dist --minify --target=chrome88 --alias:@=./src",
    "copy-assets": "cp -r public/* .",
    "prepare:dev-extension": "node ./scripts/prepare-dev-extension.js",
    "dev": "npm run prepare:dev-extension && esbuild src/content.ts src/popup.ts src/inject.ts src/inject/workers/migration.worker.ts src/inject/workers/snapshot-export.worker.ts src/inject/workers/gallery-export.worker.ts --bundle --outdir=.dev-extension/dist --minify --target=chrome88 --alias:@=./src --watch",
    "manifest:chrome": "node ./scripts/generate-manifest.js chrome",
    "manifest:firefox": "node ./scripts/generate-manifest.js firefox",
    "build:chrome": "npm run manifest:chrome && npm run build",
    "build:firefox": "npm run manifest:firefox && npm run build",
    "build:release": "bash ./scripts/build-release.sh",
    "bump:major": "node ./scripts/bump-version.js major",
    "bump:minor": "node ./scripts/bump-version.js minor",
    "bump:patch": "node ./scripts/bump-version.js patch",
    "analyze:ts": "bun ./scripts/ts-morph-index.ts",
    "analyze:ts:changed": "bun ./scripts/ts-morph-index.ts --changed",
    "context:ts": "bun ./scripts/ts-context-build.ts",
    "context:api": "bun ./scripts/ts-api-context.ts",
    "test:chrome": "bun run playwright test --headed --project=chromium",
    "test:firefox": "bun run playwright test --headed --project=firefox",
    "test:safari": "bun run playwright test --headed --project=webkit"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/chrome": "^0.1.4",
    "@types/jszip": "^3.4.1",
    "@types/node": "^24.9.1",
    "esbuild": "^0.19.0",
    "ts-morph": "^27.0.2"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "pixi.js": "^8.19.0"
  }
}
